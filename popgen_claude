    -S ^remove_samples.txt \
    filtered_mac3_hwe_imiss_0.9_miss_30_mid95percentile_autosomes_only.vcf \
    -Ov -o filtered_mac3_hwe_imiss_0.9_miss_30_mid95percentile_autosomes_only_sampes_removed.vcf

// What this means
-s        = select samples
^         = exclude these samples
-Ov       = output uncompressed VCF
-o        = output file
This approach is cleaner for large datasets.

