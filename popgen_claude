## Running the PCA ##

plink --bfile pca_data \
      --pca 10 \
      --out my_pca \
      --allow-extra-chr

//  Results saved to my_pca.eigenval and my_pca.eigenvec - these 2 files get generated


## Create a Population File. You need to map each sample to its species based on the prefix ##

awk '{
    split($2, a, "_");
    prefix = a[1];
    if (prefix == "HH") sp = "H.Hypophyllus"
    else if (prefix == "HD") sp = "H.Durgadasi"
    else if (prefix == "HS") sp = "H.Speoris"
    else sp = "Unknown"
    printf "%s %s %s", $1, $2, sp
    for (i = 3; i <= NF; i++) printf " %s", $i   # <-- this prints PC1..PC10
    print ""
}' my_pca.eigenvec > my_pca_with_pop.txt

//my_pca_with_pop.txt -this file gets generated

