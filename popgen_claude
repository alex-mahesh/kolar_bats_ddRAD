# Install if needed
install.packages("ggrepel", repos = "https://cloud.r-project.org")

library(ggplot2)
library(ggrepel)

# ── Load data ──────────────────────────────────────────────────
pca <- read.table("my_pca.eigenvec", header = FALSE)
n_pcs <- ncol(pca) - 2
colnames(pca) <- c("FID", "IID", paste0("PC", seq_len(n_pcs)))

pca$Species <- ifelse(grepl("^HH_", pca$IID), "H.Hypophyllus",
               ifelse(grepl("^HD_", pca$IID), "H.Durgadasi",
               ifelse(grepl("^HS_", pca$IID), "H.Speoris", "Unknown")))

eigenval <- scan("my_pca.eigenval")
pve <- round((eigenval / sum(eigenval)) * 100, 2)

species_colors <- c(
  "H.Hypophyllus" = "#E41A1C",
  "H.Durgadasi"   = "#377EB8",
  "H.Speoris"     = "#4DAF4A"
)

# ── Plot with labels ───────────────────────────────────────────
p <- ggplot(pca, aes(x = PC1, y = PC2, color = Species, label = IID)) +
  geom_point(size = 3, alpha = 0.85) +
  geom_text_repel(
    size          = 2.8,          # label font size
    max.overlaps  = 100,          # allow many overlaps to label all
    box.padding   = 0.4,          # space between label and point
    point.padding = 0.3,
    segment.size  = 0.3,          # line connecting label to point
    segment.alpha = 0.5,
    show.legend   = FALSE
  ) +
  scale_color_manual(values = species_colors, name = "Species") +
  labs(
    title = "PCA Plot",
    x     = paste0("PC1 (", pve[1], "% variance explained)"),
    y     = paste0("PC2 (", pve[2], "% variance explained)")
  ) +
  theme_bw(base_size = 14) +
  theme(
    plot.title      = element_text(hjust = 0.5, face = "bold", size = 16),
    legend.position = "right",
    legend.title    = element_text(face = "bold")
  )

ggsave("pca_plot_labelled.png", plot = p, width = 12, height = 9, dpi = 300)
cat("Labelled PCA plot saved as pca_plot_labelled.png\n")

