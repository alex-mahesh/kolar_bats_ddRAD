Step 2: Run RTG vcfstats Per Sample
# To run for ALL samples at once and save output
rtg vcfstats filtered_mac3_hwe_imiss_0.9_miss_60_mid95percentile_autosomes_only_sampes_removed_renamed_sorted.vcf.gz > all_sample_stats.txt

Step 3: Batch Loop — Run for All Samples
Since you have many samples (HD, HH, HS groups), automate it:
# Extract sample names from VCF header

bcftools query -l filtered_mac3_hwe_imiss_0.9_miss_60_mid95percentile_autosomes_only_sampes_removed_renamed_sorted.vcf.gz > sample_list.txt

# Loop through each sample and compute stats
while read sample; do
    echo "Processing: $sample"
    rtg vcfstats --sample "$sample" filtered_mac3_hwe_imiss_0.9_miss_60_mid95percentile_autosomes_only_sampes_removed_renamed_sorted.vcf.gz > "stats_${sample}.txt"
done < sample_list.txt

// stats_HH_7.txt -this .txt file gets created for all the 54 samples.

Step 4: Extract Heterozygosity Values
# Extract Het/Hom ratio and counts from all output files
for f in stats_*.txt; do
    sample=$(echo "$f" | sed 's/stats_//;s/.txt//')
    
    # Extract from "Total Het/Hom ratio : 0.97 (2338/2406)"
    het=$(grep "Total Het/Hom ratio" "$f" | grep -oP '\(\K[0-9]+(?=/)')
    hom=$(grep "Total Het/Hom ratio" "$f" | grep -oP '(?<=/)[0-9]+(?=\))')
    
    echo -e "$sample\t$het\t$hom"
done > heterozygosity_summary.txt

# Add header
sed -i '1s/^/Sample\tHet_count\tHom_count\n/' heterozygosity_summary.txt

cat heterozygosity_summary.txt

## Calculating Observed heterozygosity (Ho)
awk 'NR>1 {
    total = $2 + $3
    if (total > 0) ho = $2/total
    else ho = 0
    printf "%s\t%s\t%s\t%.4f\n", $1, $2, $3, ho
}' heterozygosity_summary.txt > Ho_per_sample.txt

sed -i '1s/^/Sample\tHet\tHom\tHo\n/' Ho_per_sample.txt

cat Ho_per_sample.txt
  
### plotting the graphs ###

## creating an R script
nano heterozygosity_per_sample.R

library(ggplot2)
library(dplyr)

# Read data
data <- read.table("Ho_per_sample.txt",
                   header = TRUE,
                   stringsAsFactors = FALSE)

# Assign species from sample names
data$Species <- ifelse(grepl("^HD_", data$Sample), "H. durgadasi",
                ifelse(grepl("^HS_", data$Sample), "H. speoris",
                ifelse(grepl("^HH_", data$Sample), "H. hypophyllus", NA)))

# Sort samples by Ho within species
data <- data %>%
  group_by(Species) %>%
  arrange(Ho, .by_group = TRUE) %>%
  mutate(Order = row_number()) %>%
  ungroup()

# Create a unique plotting label
data$PlotLabel <- paste(data$Species, data$Sample, sep = "__")

# Preserve the order
data$PlotLabel <- factor(data$PlotLabel,
                         levels = data$PlotLabel)

# Create a lookup table for original sample names
label_map <- setNames(data$Sample, data$PlotLabel)

# Plot
p <- ggplot(data,
            aes(x = PlotLabel,
                y = Ho,
                fill = Species)) +
  geom_col() +
  facet_grid(~Species,
             scales = "free_x",
             space = "free_x") +
  scale_x_discrete(labels = label_map) +
  theme_bw() +
  labs(
    x = "Sample",
    y = "Observed Heterozygosity (Ho)",
    title = "Observed Heterozygosity per Sample"
  ) +
  theme(
    axis.text.x = element_text(
      angle = 90,
      hjust = 1,
      size = 8
    ),
    legend.position = "none"
  )

print(p)

ggsave("Ho_per_sample_sorted.png",
       p,
       width = 14,
       height = 6,
       dpi = 300)

