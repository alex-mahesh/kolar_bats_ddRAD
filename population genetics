## plotting the PCA ##

library(ggplot2)
pca <- read.table("pca.eigenvec", header=FALSE, stringsAsFactors=FALSE)
colnames(pca) <- c("FID","IID","PC1","PC2","PC3","PC4","PC5")
species <- read.table("species.txt", header=TRUE)
merged <- merge(pca, species, by.x="IID", by.y="sample")

ggplot(merged, aes(x=PC1, y=PC2, color=species)) +
    geom_point(size=4) +
    labs(
        title="PCA plot",
        x="PC1",
        y="PC2",
        color="species"
    ) +
    theme_classic()
ggsave("PCA_plot2.png", width=8, height=6)





































