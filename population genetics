###installing plink###
conda create -n plink -c conda-forge -c bioconda plink

### converting vcf to plink format####

plink --vcf filtered_strelka.vcf \
      --allow-extra-chr \
      --set-missing-var-ids @:# \
      --make-bed \
      --out dataset

// dataset.bed  dataset.bim  dataset.fam  dataset.log  dataset.nosex the following files get created.

## got this error while running PCA, so rectifying it##
Error: Sample(s) present with no genotype data.  Use --mind to filter them out.

plink --bfile dataset \
      --allow-extra-chr \
      --mind 0.9 \
      --make-bed \
      --out dataset_pruned_clean

Why 0.9?
--mind 0.9 → removes samples with >90% missing data
This specifically targets samples with almost no data

### Running the PCA####
plink --bfile dataset_pruned_clean \
      --allow-extra-chr \
      --pca 10 \
      --out pca

//--pca: Results saved to pca.eigenval and pca.eigenvec

