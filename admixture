// save the below script to the plot_admixture.R script
## Running the R script ##
conda activate R
Rscript plot_admixture.R

library(ggplot2)
library(tidyr)
library(dplyr)

# ── SETTINGS — adjust K range as needed ───────────────────────
K_min <- 2
K_max <- 6   # change to however many Ks you want to plot

# ── Species colours (for sample labels) ───────────────────────
species_colors <- c(
  "H.Hypophyllus" = "#E41A1C",
  "H.Durgadasi"   = "#377EB8",
  "H.Speoris"     = "#4DAF4A"
)

# Admixture component colours (one per K component, up to K=10)
component_colors <- c(
  "#E41A1C", "#377EB8", "#4DAF4A", "#FF7F00",
  "#984EA3", "#A65628", "#F781BF", "#999999",
  "#FFFF33", "#66C2A5"
)

# ── Load sample/population info ────────────────────────────────
popinfo <- read.table("sample_order.txt", header = FALSE,
                      col.names = c("Sample", "Species"))

# Define species order for grouping in the plot
species_order <- c("H.Hypophyllus", "H.Durgadasi", "H.Speoris")
popinfo$Species <- factor(popinfo$Species, levels = species_order)
popinfo <- popinfo[order(popinfo$Species), ]
popinfo$Order <- seq_len(nrow(popinfo))

# ── CV error plot ──────────────────────────────────────────────
cv <- read.table("cv_errors.txt", header = FALSE,
                 col.names = c("K", "CV_error"))

cv_plot <- ggplot(cv, aes(x = K, y = CV_error)) +
  geom_line(color = "steelblue", linewidth = 1) +
  geom_point(color = "steelblue", size = 3) +
  geom_vline(xintercept = cv$K[which.min(cv$CV_error)],
             linetype = "dashed", color = "red") +
  scale_x_continuous(breaks = cv$K) +
  labs(
    title = "Cross-Validation Error by K",
    subtitle = paste("Best K =", cv$K[which.min(cv$CV_error)]),
    x = "K (number of ancestral populations)",
    y = "Cross-Validation Error"
  ) +
  theme_bw(base_size = 13) +
  theme(plot.title = element_text(hjust = 0.5, face = "bold"),
        plot.subtitle = element_text(hjust = 0.5, color = "red"))

ggsave("cv_error_plot.png", cv_plot, width = 7, height = 4, dpi = 300)
cat("CV error plot saved.\n")

# ── Admixture bar plots for each K ────────────────────────────
plots <- list()

for (K in K_min:K_max) {
  qfile <- paste0("my_data_admix.", K, ".Q")

  if (!file.exists(qfile)) {
    cat("Skipping K =", K, "— file not found\n")
    next
  }

  # Load Q matrix and attach sample/species info
  q_mat <- read.table(qfile, header = FALSE)
  colnames(q_mat) <- paste0("Comp", seq_len(K))
  q_mat$Sample  <- popinfo$Sample
  q_mat$Species <- popinfo$Species
  q_mat$Order   <- popinfo$Order

  # Reshape to long format
  q_long <- pivot_longer(q_mat,
                         cols = starts_with("Comp"),
                         names_to = "Component",
                         values_to = "Proportion")

  # Build bar plot
  p <- ggplot(q_long, aes(x = reorder(Sample, Order),
                          y = Proportion,
                          fill = Component)) +
    geom_bar(stat = "identity", width = 1, color = NA) +
    scale_fill_manual(values = component_colors[seq_len(K)],
                      name = "Ancestry\nComponent") +

    # Species labels below x-axis using facet strips
    facet_grid(. ~ Species,
               scales = "free_x",
               space  = "free_x") +

    labs(
      title    = paste0("ADMIXTURE Plot  |  K = ", K),
      subtitle = "Each bar = one individual; colours = ancestry proportions",
      x = NULL,
      y = "Ancestry Proportion"
    ) +
    scale_y_continuous(expand = c(0, 0), limits = c(0, 1),
                       breaks = c(0, 0.25, 0.5, 0.75, 1)) +
    theme_bw(base_size = 12) +
    theme(
      plot.title       = element_text(hjust = 0.5, face = "bold", size = 14),
      plot.subtitle    = element_text(hjust = 0.5, size = 10, color = "grey40"),
      axis.text.x      = element_text(angle = 90, vjust = 0.5,
                                      hjust = 1, size = 7),
      axis.title.y     = element_text(face = "bold"),
      strip.background = element_rect(fill = "grey90"),
      strip.text       = element_text(face = "bold.italic", size = 11),
      legend.position  = "right",
      panel.spacing    = unit(0.3, "lines"),
      panel.grid       = element_blank()
    )

  plots[[paste0("K", K)]] <- p
  ggsave(paste0("admixture_K", K, ".png"), p,
         width = 12, height = 4, dpi = 300)
  cat("Saved admixture_K", K, ".png\n")
}

# ── Combined multi-K plot (K_min to K_max stacked) ────────────
if (requireNamespace("gridExtra", quietly = TRUE)) {
  library(gridExtra)
} else {
  install.packages("gridExtra")
  library(gridExtra)
}

combined <- arrangeGrob(grobs = plots, ncol = 1)
ggsave("admixture_all_K.png", combined,
       width = 14, height = 4 * length(plots), dpi = 300)
cat("Combined plot saved as admixture_all_K.png\n")

