

## copying the plink files to the admixture folder ##

cp /home/alex/ddRAD/analysis/popgen/pca_data.* /home/alex/ddRAD/analysis/admixture/

## Step 1: Prepare Input (use the same pruned PLINK files from PCA) ##
## ADMIXTURE requires numeric chromosome names — recode them ##

plink --bfile pca_data \
      --chr-set 95 \
      --make-bed \
      --out my_data_admix \
      --allow-extra-chr \
      --set-missing-var-ids @:#
// if your chromosomes are named like scaffold_1, chr1 etc., you need to recode them to numbers.

#################################
The Safe Way to Recode (this was used as the above code gave error)
Don't use the simple NR % 95 awk trick from before — that can cause collisions. Use this instead, which assigns clean sequential numbers:
bash# First, get the list of unique chromosome names in order

cut -f1 pca_data.bim | sort -u > chrom_names.txt

# Check how many chromosomes you have
wc -l chrom_names.txt

// 24 chrom_names.txt -there are 24 chromosome names (it was 25 before removing X chromosome)
//17 chromosome -got this when max-missing filter was 0.7 // 19 chromosome for 0.6 max-missing

Then recode:
## Create a chromosome name mapping file ##

awk '{print $0, NR}' chrom_names.txt > chrom_map.txt

# Recode the .bim file using the mapping
awk 'NR==FNR {map[$1]=$2; next} {$1=map[$1]; print}' \
    chrom_map.txt pca_data.bim > my_data_admix.bim

# Copy the other files unchanged
cp pca_data.bed my_data_admix.bed
cp pca_data.fam my_data_admix.fam
// my_data_admix.bed my_data_admix.fam -these 2 files get created

## Verify the Recoding Worked ##
// Should show numbers like 1, 2, 3 ... instead of CM063088.1 etc.
cut -f1 my_data_admix.bim | sort -u

##### Run ADMIXTURE for each K with 10-fold cross-validation ###### 
// running admixture on screen as it takes time
screen -S admixture // creates a screen
// once you are inside the screen - CTRL A+D to detach from the screen
//                                - CTRL D to exit. This stops the analysis and screen gets closed


## installing admixture ##
conda create -n admixture -c conda-forge -c bioconda admixture
conda activate admixture

for K in $(seq 1 10); do
    admixture --cv=10 -j10 my_data_admix.bed $K | tee log_K${K}.txt
done

// log_K1.txt   log_K2.txt  my_data_admix.2.P  my_data_admix.5.P my_data_admix.3.Q  my_data_admix.6.Q -you get text,.P,.Q files for values from K=1 to 10

## Step 3: Extract Cross-Validation Errors ##
## Collect CV errors from all log files ##

grep "CV error" log_K*.txt | awk '{print $3, $4}' | sed 's/(K=//;s/)://' | sort -k1,1n > cv_errors.txt

## Step 4: Create a Population/Sample Order File ##
# Generate ordered sample list with species labels #
awk '{
    split($1, a, "_");
    prefix = a[1];
    if (prefix == "HH") sp = "H.Hypophyllus"
    else if (prefix == "HD") sp = "H.Durgadasi"
    else if (prefix == "HS") sp = "H.Speoris"
    else sp = "Unknown"
    print $1, sp
}' my_data_admix.fam > sample_order.txt

