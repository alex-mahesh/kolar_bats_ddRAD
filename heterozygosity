# RTG outputs lines like: "Sample Name  Het  Hom  ..."
# This extracts Sample, Het count, Hom count

for SP in HH HD HS; do
    awk -v sp=$SP '
    /Heterozygous/ { het = $NF }
    /Homozygous/   { hom = $NF }
    /Sample Name/  { sample = $NF }
    /^$/           { if (sample != "") print sample, sp, het, hom; sample="" }
    ' vcfstats_${SP}.txt
done > parsed_stats.txt

