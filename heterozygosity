)

# ── Load PLINK het output ──────────────────────────────────────
het <- read.table("het_results.het", header = TRUE)
colnames(het) <- c("FID", "IID", "O_HOM", "E_HOM", "N_NM", "F")

# ── Assign species from sample ID prefix ───────────────────────
het$Species <- ifelse(grepl("^HH_", het$IID), "H.Hypophyllus",
               ifelse(grepl("^HD_", het$IID), "H.Durgadasi",
               ifelse(grepl("^HS_", het$IID), "H.Speoris", "Unknown")))

het$Species <- factor(het$Species,
                      levels = c("H.Hypophyllus", "H.Durgadasi", "H.Speoris"))

# ── Calculate Ho and He per individual ────────────────────────
# Ho = 1 - O(HOM)/N(NM)  → observed heterozygosity
# He = 1 - E(HOM)/N(NM)  → expected heterozygosity
het <- het %>%
  mutate(
    Ho = 1 - (O_HOM / N_NM),
    He = 1 - (E_HOM / N_NM)
  )

# ── Per-species summary table ──────────────────────────────────
summary_table <- het %>%
  group_by(Species) %>%
  summarise(
    N       = n(),
    mean_Ho = round(mean(Ho, na.rm = TRUE), 4),
    sd_Ho   = round(sd(Ho,   na.rm = TRUE), 4),
    se_Ho   = round(sd_Ho / sqrt(N), 4),
    mean_He = round(mean(He, na.rm = TRUE), 4),
    mean_F  = round(mean(F,  na.rm = TRUE), 4),   # Fis
    .groups = "drop"
  )

cat("\n── Heterozygosity Summary ─────────────────────────────\n")
print(summary_table)

# Save tables
write.csv(het,           "heterozygosity_per_sample.csv",  row.names = FALSE)
