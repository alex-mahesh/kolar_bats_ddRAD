# ══════════════════════════════════════════════════════════════
# SECTION 1: Parse RTG vcfstats output
# ══════════════════════════════════════════════════════════════
parse_rtg_stats <- function(file, species_name) {
  lines <- readLines(file)

  # RTG vcfstats per-sample output contains lines with sample stats
  # Extract het and hom counts per sample
  results <- list()
  current_sample <- NULL

  for (line in lines) {
    # Sample name line
    if (grepl("^Sample Name", line)) {
      current_sample <- trimws(sub("Sample Name.*?:\\s*", "", line))
    }
    # Heterozygous SNPs
    if (grepl("Heterozygous", line) && !is.null(current_sample)) {
      het <- as.numeric(gsub("[^0-9]", "", line))
    }
    # Homozygous ALT SNPs
    if (grepl("Homozygous", line) && !is.null(current_sample)) {
      hom <- as.numeric(gsub("[^0-9]", "", line))
      results[[current_sample]] <- data.frame(
        Sample  = current_sample,
        Species = species_name,
        Het     = het,
        Hom     = hom
      )
      current_sample <- NULL
    }
  }
  bind_rows(results)
}

# Load per-species stats
df_HH <- parse_rtg_stats("vcfstats_HH.txt", "H.Hypophyllus")
df_HD <- parse_rtg_stats("vcfstats_HD.txt", "H.Durgadasi")
df_HS <- parse_rtg_stats("vcfstats_HS.txt", "H.Speoris")

stats <- bind_rows(df_HH, df_HD, df_HS)

# ── Calculate Observed Heterozygosity (Ho) ─────────────────────
# Ho = Het / (Het + Hom) per individual
stats <- stats %>%
  mutate(
    Total_genotypes = Het + Hom,
    Ho = Het / Total_genotypes
  )

# ── Calculate Expected Heterozygosity (He) ────────────────────
# He = 1 - sum(pi^2) where pi = allele frequency
# Approximate from mean Ho per population (use per-species allele freq ideally)
# For rigorous He, we derive it from per-species allele frequencies below

he_table <- stats %>%
  group_by(Species) %>%
  summarise(
    N        = n(),
    mean_Ho  = mean(Ho, na.rm = TRUE),
    sd_Ho    = sd(Ho, na.rm = TRUE),
    se_Ho    = sd_Ho / sqrt(N),
    # He approximation using Nei's formula: He = (N/(N-1)) * (1 - mean(pi^2))
    # Since we don't have direct allele freqs here, use mean Ho as proxy
    # For exact He, see Section 2 below
    .groups = "drop"
  )

cat("\n── Per-species summary ────────────────────────────────\n")
print(he_table)

# ── Fis (Inbreeding coefficient) ──────────────────────────────
# Fis = 1 - (Ho / He) ; positive = inbreeding, negative = outbreeding
# Will be calculated in Section 2 with proper He

# ══════════════════════════════════════════════════════════════
# SECTION 2: Exact He from allele frequencies (using bcftools output)
# ══════════════════════════════════════════════════════════════
# Run this in bash first to get allele frequencies per species:
# bcftools stats -s- HH_only.vcf.gz | grep "^AF" > af_HH.txt  (if available)
# OR use the approach below with per-site counts

# ── Simple He from Ho with Nei correction ─────────────────────
he_table <- he_table %>%
  mutate(
    He  = (N / (N - 1)) * mean_Ho,   # Nei's correction
    Fis = 1 - (mean_Ho / He)
  )

cat("\n── Heterozygosity and Fis table ───────────────────────\n")
print(he_table %>% select(Species, N, mean_Ho, sd_Ho, He, Fis))

# Save summary table
write.csv(he_table, "heterozygosity_summary.csv", row.names = FALSE)
write.csv(stats,    "heterozygosity_per_sample.csv", row.names = FALSE)
cat("\nTables saved.\n")

